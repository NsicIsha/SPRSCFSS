    <link type="text/css" rel="Stylesheet" href="../CSS/StyleAdmin.css" />

    <script language="javascript" type="text/javascript" src="../JScript/JSAdmin.js"></script>
    
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
    <div>
       <table width="900" border="0" cellpadding="0" cellspacing="0" style="background-color: #FFFFFF;">
                <tr>
                    <td colspan="2">
                        <uc1:Header_Agency ID="Header_Agency1" runat="server" />
                    </td>
                </tr>
                <tr>
                    <td align="left" style="height: 435px; vertical-align: top; width: 200px; background-color: #DDF1F7;">
                        <uc3:TreeMenu_Admin ID="TreeMenu_Admin1" runat="server" />
                    </td>
                    <td style="vertical-align: top; width: 700px;">
                        
                                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                                </asp:ContentPlaceHolder>
                        
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <uc2:Footer_Admin ID="Footer_Admin1" runat="server" />
                    </td>
                </tr>
            </table>
    </div>
    </form>
</body>
</html>
