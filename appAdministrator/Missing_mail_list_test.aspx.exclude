<%@ Page Language="C#" AutoEventWireup="true"  MasterPageFile="~/appMaster/Admin.master" CodeFile="Missing_mail_list_test.cs" Inherits="appAdministrator_Missing_mail_list_test" %>


<asp:Content ID="Content1" ContentPlaceHolderID="head" Runat="Server">

    
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.5.1/jquery.min.js"></script>
    
    <style type="text/css">
        
    .leftHeading
    {
	font-family:Arial, Helvetica, sans-serif;
	font-size: 12px;
	height:35px;
	padding-left:5px;
	padding-right:5px;
	font-weight:bold;
    }

body {
  margin: 0px;
  padding: 0px;
  background:#d6cbcf;
}

#header {
  background: #0f0;
  width: 800px;
  height: 100px;
}

.leftext
{
	
	font-family:Arial, Sans-Serif, Courier;
	font-size:12px;
	font-weight:bold;
	float:left;
	height:14px;
	width:40%;
	
}

.coloncls
{
	font-size:12px;
	font-weight:bold;
	float:left;
	height:14px;
	width:5%;
	
}

.clstxtbx
{
	background:#afacbc;
	font-family:Courier;
	font-size:12px;
	padding:1px;
	height:14px;
	float:left;
	width:100%;
}

.txtdiv
{
	height:14px;
	width:50%;
	float:left;
}

.clsrowdiv
{
	position:static;
	left:50px;
	height:20px;
	width:250px;
	padding-bottom:5px;
}

.tbldiv
{
	
	left:10px;
	top:100px;
	float:left;
	width:300px;
	height:500px;
}

#leftcol {
  background: #f00;
  float: left;
  width: 20%;
  height: 500px;
}
#rightcol {
  background: #f00;
  float: right;
  width: 20%;
  height: 500px;
}
#content {
  background: #fff;
  float: left;
  width: 59%;
  height: 500px;
}
#footer {
  background: #0f0;
  clear: both;
  width: 100%;
}

</style>
</asp:Content>
