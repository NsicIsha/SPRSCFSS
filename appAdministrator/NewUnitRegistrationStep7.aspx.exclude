<%@ Page Title="NSIC SPR :: New Unit Registration:Step 7" Language="C#" MasterPageFile="~/appMaster/AdminUpload.master" AutoEventWireup="true" CodeFile="NewUnitRegistrationStep7.aspx.cs" Inherits="appAdministrator_NewUnitRegistrationStep7" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" Runat="Server">
<script type="text/javascript" language="javascript">

                  function disableBackButton() {
            window.history.forward();
        }
        setTimeout("disableBackButton()", 0);
           
        $(document).ready(function()
         {
            $("#progressbar").progressbar({ value: 100 });
            });
             
        function updateProgress() {            
            var value = $("#progressbar").progressbar("option", "100");
            if (value < 100) {
                $("#progressbar").progressbar("value", value + 1);                
            }
        }
        
          function UpdateProgressBar_DroDown()
            {
               $("#progressbar").progressbar({ value: 100 });
            }
               
    </script>
    <style type="text/css">
        .style1
        {
