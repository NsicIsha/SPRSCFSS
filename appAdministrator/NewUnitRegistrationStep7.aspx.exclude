            padding-left: 5px;
            padding-right: 5px;
            font-weight: bold;
        }
        
        .ErrMsgLbl
        {
        	font-weight:bold;
        	font-style:italic;
        	text-decoration:underline;
        	color:Red;
        	}
        
        .style2
        {
            height: 22px;
        }
        
    </style>
</asp:Content>
