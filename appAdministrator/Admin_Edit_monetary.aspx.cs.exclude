                  //txtml1.Text = Table.Rows[3]["Unit1"].ToString();
                  //txtml2.Text = Table.Rows[3]["Unit2"].ToString();
                  //txtml3.Text = Table.Rows[3]["Unit3"].ToString();
                  ViewState["ml1"] = newTable.Rows[3]["Profit1"].ToString();
                  ViewState["ml2"] = newTable.Rows[3]["Profit2"].ToString();
