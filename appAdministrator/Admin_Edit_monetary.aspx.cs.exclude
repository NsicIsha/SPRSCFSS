    { 
  
    }




    protected void btnSubmit_Click(object sender, EventArgs e)
    {
        if (txtml1.Text != string.Empty)
        {
            if (Convert.ToDecimal(ViewState["ml1"].ToString()) < Convert.ToDecimal(txtml1.Text))
            {
                ScriptManager.RegisterStartupScript(this, GetType(), "showalert", "alert('Unit 1 Monetary limit cannot be more than that set by Branch Accounts.');", true);
                return;
            }
        }
        if (txtml2.Text != string.Empty)
        {
            if (Convert.ToDecimal(ViewState["ml2"].ToString()) < Convert.ToDecimal(txtml2.Text))
            {
                ScriptManager.RegisterStartupScript(this, GetType(), "showalert", "alert('Unit 2 Monetary limit  cannot be more than that set by Branch Accounts..');", true);
                return;
            }
        }
        if (txtml3.Text != string.Empty)
        {
            if (Convert.ToDecimal(ViewState["ml3"].ToString()) < Convert.ToDecimal(txtml3.Text))
            {
                ScriptManager.RegisterStartupScript(this, GetType(), "showalert", "alert('Unit 3 Monetary limit  cannot be more than that set by Branch Accounts.');", true);
                return;
            }
        }
        if (txtml4.Text != string.Empty)
        {
            if (Convert.ToDecimal(ViewState["ml4"].ToString()) < Convert.ToDecimal(txtml4.Text))
            {
                ScriptManager.RegisterStartupScript(this, GetType(), "showalert", "alert('Unit 4 Monetary limit  cannot be more than that set by Branch Accounts.');", true);
                return;
            }
        }
        if (txtml5.Text != string.Empty)
        {
            if (Convert.ToDecimal(ViewState["ml5"].ToString()) < Convert.ToDecimal(txtml5.Text))
            {
                ScriptManager.RegisterStartupScript(this, GetType(), "showalert", "alert('Unit 5 Monetary limit  cannot be more than that set by Branch Accounts.');", true);
                return;
            }
        }
        

        StringBuilder str = new StringBuilder();
        string[] unitid = commalist.Split(new char[] { ',' });
        for (int i = 1; i <= unitcount; i++)
        {
            str.Append("<MonetaryLimit>");
            str.Append("<UnitID>" + unitid[i - 1].ToString() + "</UnitID>");
            if (i == 1)
            {
                str.Append("<ML>" + txtml1.Text + "</ML>");
                str.Append("<PML>" +ViewState["ml1"].ToString() + "</PML>");
            }
            else if (i == 2)
            {
                str.Append("<ML>" + txtml2.Text + "</ML>");
                   str.Append("<PML>" + ViewState["ml2"].ToString() + "</PML>");
            }

            else if (i == 3)
            {
                str.Append("<ML>" + txtml3.Text + "</ML>");
                   str.Append("<PML>" +ViewState["ml3"].ToString() + "</PML>");
            }

            else if (i == 4)
            {
                str.Append("<ML>" + txtml4.Text + "</ML>");
                   str.Append("<PML>" + ViewState["ml4"].ToString() + "</PML>");
            }
            else
            {
                str.Append("<ML>" + txtml5.Text + "</ML>");
                str.Append("<PML>" + ViewState["ml5"].ToString() + "</PML>");
            }
            str.Append("</MonetaryLimit>");

            
        }

        clsCompany OBJCOM = new clsCompany();
        int sussid;
        companyid = Convert.ToInt32(Request.QueryString["id"]);
        sussid = OBJCOM.F_Update_MonetaryLimit(str.ToString(), Convert.ToInt32(Request.QueryString["urlid"]), UserId,companyid);
        if (sussid == 1)
        {
            Response.Redirect("Home.aspx");
        }
    }
}

public class DynamicallyTemplatedGridViewHandler : ITemplate
{
    #region data memebers

    ListItemType ItemType;
    string FieldName;
    string InfoType;
    int totalrow;
    int currentindex;

    #endregion

    #region constructor

    public DynamicallyTemplatedGridViewHandler(ListItemType item_type, string field_name, string info_type)
    {
        ItemType = item_type;
        FieldName = field_name;
        InfoType = info_type;
       
    }

    #endregion


    #region Methods

    public void InstantiateIn(System.Web.UI.Control Container)
    {
        switch (ItemType)
        {
            case ListItemType.Header:
                Literal header_ltrl = new Literal();
             //   header_ltrl.Text = "<b>" + FieldName + "</b>";
                header_ltrl.Text = FieldName;
                Container.Controls.Add(header_ltrl);
                break;
            case ListItemType.Item:
                switch (InfoType)
                {
                    case "Command":
                        //ImageButton edit_button = new ImageButton();
                        //edit_button.ID = "edit_button";
                        //edit_button.ImageUrl = "~/images/Admin/edit.PNG";
                        //edit_button.Width = 24;
                        //edit_button.Height = 24;
                        //edit_button.CommandName = "Edit";
                        //edit_button.Click += new ImageClickEventHandler(edit_button_Click);
                        
                        //edit_button.ToolTip = "Edit";
                        //Container.Controls.Add(edit_button);

                       
                            LinkButton edit_lnk = new LinkButton();
                            edit_lnk.Text = "<b>Edit</b>" + "  ";
                            edit_lnk.ToolTip = "Edit";
                            edit_lnk.CommandName = "Edit";
                            edit_lnk.Click += new EventHandler(edit_button_Click);
                            Container.Controls.Add(edit_lnk);
                   
                        

                        //LinkButton delete_lnk = new LinkButton();
                        //delete_lnk.Text = "  " + " <b>Delete</b>";
                        //delete_lnk.ToolTip = "Delete";
                        //delete_lnk.CommandName = "Delete";
                        //delete_lnk.OnClientClick = "return confirm('Are you sure to delete the record?')";
                        //Container.Controls.Add(delete_lnk);

                        //ImageButton delete_button = new ImageButton();
                        //delete_button.ID = "delete_button";
                        //delete_button.ImageUrl = "~/images/Admin/delete.PNG";
                        //delete_button.CommandName = "Delete";
                        //delete_button.ToolTip = "Delete";
                        //delete_button.Width = 24;
                        //delete_button.Height = 24;
                        //delete_button.OnClientClick = "return confirm('Are you sure to delete the record?')";
                        //Container.Controls.Add(delete_button);

                    

                        break;

                    default:
                        Label field_lbl = new Label();
                        field_lbl.ID = FieldName;
                        field_lbl.Text = String.Empty; //we will bind it later through 'OnDataBinding' event
                        field_lbl.DataBinding += new EventHandler(OnDataBinding);
                        Container.Controls.Add(field_lbl);
                        break;

                }
                break;
            case ListItemType.EditItem:
                if (InfoType == "Command")
                {
                    //ImageButton update_button = new ImageButton();
                    LinkButton update_button = new LinkButton();
                    update_button.ID = "update_button";
                    update_button.CommandName = "Update";
                    update_button.Text = "<b> Update   </b>";
                  //  update_button.ImageUrl = "~/images/update.gif";
                    if ((int)new Page().Session["InsertFlag"] == 1)
                        update_button.ToolTip = "Add";
                    else
                        update_button.ToolTip = "Update";
                    update_button.OnClientClick = "return confirm('Are you sure to update the record?')";
                    Container.Controls.Add(update_button);

                  //  ImageButton cancel_button = new ImageButton();
                    LinkButton cancel_button = new LinkButton();
                 //   cancel_button.ImageUrl = "~/images/cancel.gif";
                    cancel_button.ID = "cancel_button";
                    cancel_button.Text = "<b>    Cancel</b>";
                    cancel_button.CommandName = "Cancel";
                    cancel_button.ToolTip = "Cancel";
                    Container.Controls.Add(cancel_button);

                }
                else// for other 'non-command' i.e. the key and non key fields, bind textboxes with corresponding field values
                {
                    TextBox field_txtbox = new TextBox();
                    field_txtbox.ID = FieldName;
                    field_txtbox.Text = String.Empty;
                    field_txtbox.Width = 90;
                    // if Inert is intended no need to bind it with text..keep them empty
                    if ((int)new Page().Session["InsertFlag"] == 0)
                        field_txtbox.DataBinding += new EventHandler(OnDataBinding);
                    Container.Controls.Add(field_txtbox);

                }
                break;

        }

    }

    #endregion

    #region Event Handlers

    //just sets the insert flag OFF so that we ll be able to decide in OnRowUpdating event whether to insert or update 
    protected void edit_button_Click(Object sender, EventArgs e)
    {
        new Page().Session["InsertFlag"] = 0;
    }


    private void OnDataBinding(object sender, EventArgs e)
    {

        object bound_value_obj = null;
        Control ctrl = (Control)sender;
        IDataItemContainer data_item_container = (IDataItemContainer)ctrl.NamingContainer;
        bound_value_obj = DataBinder.Eval(data_item_container.DataItem, FieldName);

        switch (ItemType)
        {
            case ListItemType.Item:
                Label field_ltrl = (Label)sender;
                field_ltrl.Text = bound_value_obj.ToString();

                break;
            case ListItemType.EditItem:
                TextBox field_txtbox = (TextBox)sender;
                field_txtbox.Text = bound_value_obj.ToString();

                break;
        }


    }

    #endregion

}


