    public void gvmonetary_RowEditing(object sender, GridViewEditEventArgs e)
    {
       // int unitid = Convert.ToInt32( Table.Columns[1].ColumnName);
        gvmonetary.EditIndex = e.NewEditIndex;
        gvmonetary.DataBind();
        Session["SelecetdRowIndex"] = e.NewEditIndex;
    }


    public void gvmonetary_RowCancelingEdit(object sender, GridViewCancelEditEventArgs e)
    {
        gvmonetary.EditIndex = -1;
        gvmonetary.DataBind();
        Session["SelecetdRowIndex"] = -1;

    }

    public void gvmonetary_RowUpdating(Object sender, GridViewUpdateEventArgs e)
    {
        try
        {

        clsCompanyInformationEdit objcom = new clsCompanyInformationEdit();
      
        GridViewRow row = gvmonetary.Rows[e.RowIndex];
        string field_value0 = ((TextBox)row.FindControl(Table.Columns[0].ColumnName)).Text;
        ParameterArray.Add(field_value0);
        for (int i =1; i < Table.Columns.Count; i++)
        {
            string field_value = ((TextBox)row.FindControl(Table.Columns[i].ColumnName)).Text;
            ParameterArray.Add(field_value);
        }

        StringBuilder str = new StringBuilder();

        string yearval, yearamt;
        yearval = "";
        yearamt = "";
        string Query = "";
        int result = 0;
        if (e.RowIndex < Table.Rows.Count - 1)
        {

            
            string[] words = commalist.Split(',');
            int counter = 1;
         
            foreach (string word in words)
            {
                //  Table.Columns[i + 1].ColumnName = word;
                yearval = "fGPtbl_CUnit_TO_Year" + (e.RowIndex + 1).ToString();
                yearamt = "fGPtbl_CUnit_TO_Amount_Year" + (e.RowIndex + 1).ToString();
                //str.Append("<turnover>");
                //str.Append("<" + yearval + ">" + ParameterArray[0].ToString() + "</" + yearval + ">");
                //str.Append("<" + yearamt + ">" + ParameterArray[1].ToString() + "</" + yearamt + ">");
                //str.Append("<unitid>" + word + "</unitid>");
                //str.Append("</turnover>");
                if (processid == 1)
                {
                    Query = "update GPtbl_CUnit_Turnover set " +  yearval  + "="
                        + "'" + ParameterArray[0].ToString() + "'" + "," + yearamt + " ="
                        + ParameterArray[counter].ToString() + " ,fGPtbl_CUnit_TO_Form_typeid = " + processid + "  "
                         + " ,fGPtbl_CUnit_TO_EUser =  " + UserId + "  where fGPtbl_CUnit_TO_CompanyId = " + companyid + " and fGPtbl_CUnit_TO_UnitId = " + word + "  ";
                    result = objcom.f_update_monetary_trunover(Query);     
                }
                else
                {
                    //Query = "update GPtbl_CUnitAmendment_Turnover set " + yearval + "="
                    //  + "'" + ParameterArray[0].ToString() + "'" + "," + yearamt + " ="
                    //  + ParameterArray[counter].ToString() + "  where fGPtbl_CUnit_TO_CompanyId = " + companyid + " and fGPtbl_CUnit_TO_UnitId = " + word + "  ";
                    Query = "update GPtbl_CUnitAmendment_Turnover set " + yearval + "="
                        + "'" + ParameterArray[0].ToString() + "'" + "," + yearamt + " ="
                        + ParameterArray[counter].ToString() + " ,fGPtbl_CUnit_TO_Form_typeid = " + processid + "  "
                         + " ,fGPtbl_CUnit_TO_EUser =  " + UserId + "  where fGPtbl_CUnit_TO_CompanyId = " + companyid + " and fGPtbl_CUnit_TO_UnitId = " + word + "  ";

                    result = objcom.f_update_monetary_trunover(Query);     
                }
                counter = counter + 1;
                
            }
           
        }


        if (e.RowIndex == Table.Rows.Count - 1)
        {
            string[] words = commalist.Split(',');
            int counter = 1;
            foreach (string word in words)
            {
                Query = "Update GPtbl_CUnit_MonetoryLimit set fGPtbl_CUnit_ML_MonetoryLimit = " + ParameterArray[counter].ToString() + ", "
                               + " fGPtbl_CUnit_ML_FormtypeId = " + processid + " , fGPtbl_CUnit_ML_EUser = " + UserId + " where  fGPtbl_CUnit_ML_UnitId = " + word;
                result = objcom.f_update_monetary_trunover(Query);     
                counter = counter + 1;
            }
        }
        
      //  gvmonetary.EditIndex = -1;
        //gvmonetary.DataBind();

       Response.Redirect(Request.Url.AbsoluteUri);
        //gvmonetary.DataSource = Table;
        //gvmonetary.DataBind();
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message + "  " + ex.Message);
        }
    }

