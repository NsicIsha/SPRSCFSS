                </td>
             </tr>
            
            <tr align="left" valign="top">
                <td align="left" class="modalTDtextBOLD" colspan="2">
                    Upload Report:
                </td>
                <td align="left" valign="top" style="padding-bottom:10px;">
                    <asp:FileUpload ID="FileUpload1" runat="server"                   
