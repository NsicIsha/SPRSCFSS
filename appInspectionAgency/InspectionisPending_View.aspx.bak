                     <span style="color: #FF0000; padding-top: 5px;">Only .jpg, .jpeg, .gif, .png, .pdf format are allowed.</span> <br />
                    <span style="color: #FF0000; padding-top: 5px;"> Size limit for .jpg, .jpeg, .gif, .png is 50KB and Size limit for .pdf is 10MB</span>
                      <%--onchange=" var result=CheckExtension(this); return result"--%>
                 <%--   <asp:RequiredFieldValidator ID="RFValidatorUpload" runat="server" ErrorMessage="Please select a file"
                    ControlToValidate="FileUpload1" Display="None" ValidationGroup="1" SetFocusOnError="true"></asp:RequiredFieldValidator>
                    <asp:RegularExpressionValidator
                        ID="RegularExpressionValidator1" runat="server" Display="None" ValidationGroup="1"
                        ErrorMessage="You can upload only .jpg, .jpeg, .gif, .png, .doc, .docx, .xls, .xlsx, .pdf, .txt files"
