    //TO INSERT OR UPDATE
    public int MasterInspectionAgency_User_InsertUpdate(int InspectionAgency_UserId, int InspectionAgencyId,
        string InspectionAgency_UserName, string InspectionAgency_UserEmail,
        string InspectionAgency_UserDescription, string InspectionAgency_UserLoginname,int UserId)
    {
        try
        {
            RandomKeyGenerator objRand = new RandomKeyGenerator();
            string passwd = objRand.Generate();

            MySqlComm = new SqlCommand("GPsp_Update_MasterInspectionAgency_User", DBManager.ConnectToDB());
            MySqlComm.CommandType = CommandType.StoredProcedure;

            MySqlComm.Parameters.Add("@fGPtbl_MIAU_Id", SqlDbType.Int).Value = InspectionAgency_UserId;
            if (InspectionAgencyId!=0) MySqlComm.Parameters.Add("@fGPtbl_MIAU_AgencyId", SqlDbType.Int).Value = InspectionAgencyId;
            if (InspectionAgency_UserName.Trim() != "") MySqlComm.Parameters.Add("@fGPtbl_MIAU_Name", SqlDbType.VarChar, 100).Value = InspectionAgency_UserName;
            if (InspectionAgency_UserEmail != "") MySqlComm.Parameters.Add("@fGPtbl_MIAU_Email", SqlDbType.VarChar, 50).Value = InspectionAgency_UserEmail;
            MySqlComm.Parameters.Add("@fGPtbl_MIAU_Password", SqlDbType.NVarChar, 50).Value = passwd;
            if (InspectionAgency_UserDescription.Trim() != "") MySqlComm.Parameters.Add("@fGPtbl_MIAU_Description", SqlDbType.VarChar, 2000).Value = InspectionAgency_UserDescription;
            if (InspectionAgency_UserLoginname.Trim() != "") MySqlComm.Parameters.Add("@fGPtbl_MIAU_UserName", SqlDbType.VarChar, 50).Value = InspectionAgency_UserLoginname;
            MySqlComm.Parameters.Add("@UserId", SqlDbType.Int).Value = UserId;

            SqlParameter outVal = new SqlParameter("Output", SqlDbType.Int);
            outVal.Direction = ParameterDirection.Output;
            MySqlComm.Parameters.Add(outVal);

            MySqlComm.ExecuteNonQuery();
            ErrorId = Convert.ToInt32(outVal.Value);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MySqlComm.Dispose();
        }
        return ErrorId;
    }

