                MyAdp.SelectCommand.CommandType = CommandType.StoredProcedure;
                MyAdp.SelectCommand.Parameters.Add("@fGPtbl_CUnitAmendment_Id", SqlDbType.Int).Value = amendmentid;
            }
            

            MyAdp.SelectCommand.Parameters.Add("@Unitid", SqlDbType.Int).Value = Unitid;
            MyAdp.SelectCommand.Parameters.Add("@Companyid", SqlDbType.Int).Value = Companyid;
            MyAdp.SelectCommand.Parameters.Add("@Formtypeid", SqlDbType.Int).Value = Formtypeid;

            MyAdp.Fill(MyDt);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
