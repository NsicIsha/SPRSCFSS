    //TO INSERT OR UPDATE
    public int MasterInspectionAgency_InsertUpdate(int MasterInspectionAgencyId, string fGPtbl_MIA_Name, string fGPtbl_MIA_Desc, int UserId)
    {
        try
        {
            /*RandomKeyGenerator objRand = new RandomKeyGenerator();
            string passwd = objRand.Generate();*/

            MySqlComm = new SqlCommand("GPsp_Update_MasterInspectionAgency", DBManager.ConnectToDB());
            MySqlComm.CommandType = CommandType.StoredProcedure;

            MySqlComm.Parameters.Add("@fGPtbl_MIA_Id", SqlDbType.Int).Value = MasterInspectionAgencyId;
            if (fGPtbl_MIA_Name.Trim() != "") MySqlComm.Parameters.Add("@fGPtbl_MIA_Name", SqlDbType.VarChar, 200).Value = fGPtbl_MIA_Name;
            //if (fGPtbl_MIA_Email!="") MySqlComm.Parameters.Add("@fGPtbl_MIA_Email", SqlDbType.VarChar, 100).Value=fGPtbl_MIA_Email;
            //MySqlComm.Parameters.Add("@fGPtbl_MIA_Pwd", SqlDbType.NVarChar, 50).Value = passwd;
            if (fGPtbl_MIA_Desc.Trim() != "") MySqlComm.Parameters.Add("@fGPtbl_MIA_Desc", SqlDbType.VarChar, 2000).Value = fGPtbl_MIA_Desc;
            MySqlComm.Parameters.Add("@UserId", SqlDbType.Int).Value = UserId;

            SqlParameter outVal = new SqlParameter("Output", SqlDbType.Int);
            outVal.Direction = ParameterDirection.Output;
            MySqlComm.Parameters.Add(outVal);

            MySqlComm.ExecuteNonQuery();
            ErrorId = Convert.ToInt32(outVal.Value);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MySqlComm.Dispose();
        }
        return ErrorId;
    }

