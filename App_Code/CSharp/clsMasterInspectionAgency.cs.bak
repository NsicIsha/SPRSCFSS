    public int Agency_Update_InspectionStatus(int amendmentid, int unitid, int agencyid, int formtypeid, int inspectionstatus, string issuedate, int userid)
    {
        try
        {
            MySqlComm = new SqlCommand("GPsp_Agency_Update_InspectionStatus", DBManager.ConnectToDB());
            MySqlComm.CommandType = CommandType.StoredProcedure;

            MySqlComm.Parameters.Add("@fGPtbl_IS_RenewalAmendmentId", SqlDbType.Int).Value = amendmentid;
            MySqlComm.Parameters.Add("@fGPtbl_IS_UnitId", SqlDbType.Int).Value = unitid;
            MySqlComm.Parameters.Add("@fGPtbl_IS_AgencyId", SqlDbType.Int).Value = agencyid;
            MySqlComm.Parameters.Add("@fGPtbl_IS_FormtypeId", SqlDbType.Int).Value = formtypeid;
            MySqlComm.Parameters.Add("@fGPtbl_IS_InspectionStatus", SqlDbType.Int).Value = inspectionstatus;
            MySqlComm.Parameters.Add("@fGPtbl_IS_DateStatus4", SqlDbType.DateTime).Value = Convert.ToDateTime(issuedate);
            MySqlComm.Parameters.Add("@UserId", SqlDbType.Int).Value = userid; 
            

            SqlParameter outVal = new SqlParameter("@Output", SqlDbType.Int);
            outVal.Direction = ParameterDirection.Output;
            MySqlComm.Parameters.Add(outVal);

            MySqlComm.ExecuteNonQuery();
            ErrorId = Convert.ToInt32(outVal.Value);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MySqlComm.Dispose();
        }
        return ErrorId;
    }


    //TO FETCH INSPECTION IS PENDING FOR AGENCY
    public DataTable Agency_Fetch_InspectionisPending(int id, int AgencyId, int BranchId, int InspUserId)
    {
        try
        {
            MyDt = new DataTable();
            if (id == 1)//FOR REGISTRATION
            {
                MyAdp = new SqlDataAdapter("GPsp_Agency_Fetch_InspectionisPending", DBManager.ConnectToDB());
            }
            else if (id == 3)//FOR AMENDMENT
            {
                MyAdp = new SqlDataAdapter("GPsp_AgencyAmendment_Fetch_InspectionisPending", DBManager.ConnectToDB());
            }

            MyAdp.SelectCommand.CommandType = CommandType.StoredProcedure;

            MyAdp.SelectCommand.Parameters.Add("@AgencyId", SqlDbType.Int).Value = AgencyId;
            if (id == 1)
            {
                MyAdp.SelectCommand.Parameters.Add("@BranchId", SqlDbType.Int).Value = BranchId;
                MyAdp.SelectCommand.Parameters.Add("@InspUserId", SqlDbType.Int).Value = InspUserId; 
            }
            MyAdp.Fill(MyDt);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MyAdp.Dispose();
        }
        return MyDt;
    }

