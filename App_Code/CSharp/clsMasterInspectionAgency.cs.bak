    #region Agency

    public DataTable Agency_Fetch_DatetobeIssued(int id, int AgencyId, int branchid, int inspuserid)
    {
        try
        {
            MyDt = new DataTable();
            if (id == 1)
            {
                MyAdp = new SqlDataAdapter("GPsp_Agency_Fetch_DatetobeIssued", DBManager.ConnectToDB());
            }
            else if (id == 3)
            {
                MyAdp = new SqlDataAdapter("GPsp_AgencyAmendment_Fetch_DatetobeIssued", DBManager.ConnectToDB());
            }
            MyAdp.SelectCommand.CommandType = CommandType.StoredProcedure;

            MyAdp.SelectCommand.Parameters.Add("@AgencyId", SqlDbType.Int).Value = AgencyId;
            MyAdp.SelectCommand.Parameters.Add("@Formtypeid", SqlDbType.Int).Value = id;
            MyAdp.SelectCommand.Parameters.Add("@BranchId", SqlDbType.Int).Value = branchid;
            MyAdp.SelectCommand.Parameters.Add("@InspUserId", SqlDbType.Int).Value = inspuserid;
            MyAdp.Fill(MyDt);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MyAdp.Dispose();
        }
        return MyDt;
    }


    public DataTable Agency_Fetch_DatetobeIssuedByUnitCompanyFormtype(int amendmentid, int Unitid, int Companyid, int Formtypeid)
