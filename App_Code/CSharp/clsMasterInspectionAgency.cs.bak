            MySqlComm = new SqlCommand("Gpsp_update_MasterBuyingAgenyUser", DBManager.ConnectToDB());
            MySqlComm.CommandType = CommandType.StoredProcedure;
            MySqlComm.Parameters.Add("@fGPtbl_MBAU_Id", SqlDbType.Int).Value = UserId;
            MySqlComm.Parameters.Add("@fGPtbl_MBAU_Email", SqlDbType.VarChar, 50).Value = Email;
            MySqlComm.Parameters.Add("@fGPtbl_MBAU_Remark", SqlDbType.VarChar, 2000).Value = Remarks;

            SqlParameter outError = new SqlParameter("@ErrorId", SqlDbType.Int);
            outError.Direction = ParameterDirection.Output;
            MySqlComm.Parameters.Add(outError);

            MySqlComm.ExecuteNonQuery();
            ErrorId = Convert.ToInt32(outError.Value);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MySqlComm.Dispose();
        }
        return ErrorId;
    }

    public int MasterBuyingAgency_ChangePassword(int UserId, string Newpassword, string Oldpassword, int Edituser)
    {
        try
        {

            /*SIMPLE PASSWORD 7/6/2012
             DecryptEncrypt objDecEnc = new DecryptEncrypt();*/
            string EncryptedPwd = Newpassword.ToString().Trim();
            string EncryptedOldPwd = Oldpassword.ToString().Trim();
            MySqlComm = new SqlCommand("GPsp_MasterBuyingAgency_ChangePassword", DBManager.ConnectToDB());
            MySqlComm.CommandType = CommandType.StoredProcedure;
            MySqlComm.Parameters.Add("@fGPtbl_MBAU_Id", SqlDbType.Int).Value = UserId;
            MySqlComm.Parameters.Add("@NewPassword", SqlDbType.NVarChar, 100).Value = EncryptedPwd;
            MySqlComm.Parameters.Add("@fGPtbl_MBAU_Password", SqlDbType.NVarChar, 100).Value = EncryptedOldPwd;
            MySqlComm.Parameters.Add("@fGPtbl_MBAU_EUser", SqlDbType.Int).Value = Edituser;
            SqlParameter outVal = new SqlParameter("@Output", SqlDbType.Int);
            outVal.Direction = ParameterDirection.Output;
            MySqlComm.Parameters.Add(outVal);
            MySqlComm.ExecuteNonQuery();
            ErrorId = Convert.ToInt32(outVal.Value);
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }
        finally
        {
            DBManager.CloseConnection();
            MySqlComm.Dispose();
        }
        return ErrorId;
    }

