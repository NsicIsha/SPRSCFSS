    public SqlDataReader Fetch_AgencyByName(string fGPtbl_TIAB_UserName, string fGPtbl_TIAB_Pwd)
    {
        try
        {
            /*SIMPLE PASSWORD 7/6/2012
             DecryptEncrypt objDecEnc = new DecryptEncrypt();
             string EncryptedPwd = objDecEnc.Encrypt(fGPtbl_TIAB_Pwd.ToString().Trim());*/
            string EncryptedPwd = fGPtbl_TIAB_Pwd.ToString().Trim();

            MySqlComm = new SqlCommand("GPsp_Fetch_AgencyByName", DBManager.ConnectToDB());
            MySqlComm.CommandType = CommandType.StoredProcedure;

            MySqlComm.Parameters.Add("@fGPtbl_TIAB_UserName", SqlDbType.VarChar, 200).Value = fGPtbl_TIAB_UserName;
            MySqlComm.Parameters.Add("@fGPtbl_TIAB_Pwd", SqlDbType.VarChar, 2000).Value = EncryptedPwd;

            MyDr = MySqlComm.ExecuteReader();
        }
        catch (Exception ex)
        {
            ErrHandler.WriteError(ex.Message);
        }

        return MyDr;
    }

