        string userName = Request.QueryString["uname"];
        int index = userName.IndexOf(" ");
        bool chk=(userName.IndexOf(" ")!=-1);
        int rowAffected = oDiSchemesBLL.CheckUserId(Request.QueryString["uname"]);
        if (chk)
        {
            Response.Write("space");
        }
        else
        {
            if (rowAffected >= 1)
